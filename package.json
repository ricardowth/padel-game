{
  "name": "padel-career-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based, decision-driven padel career simulator (unofficial fan-made).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sim": "tsx scripts/sim-career.ts",
    "smoke": "node scripts/smoke-ui.mjs",
    "check:emoji": "node scripts/check-emoji.mjs",
    "data:fetch": "node scripts/fetch-fip.mjs && node scripts/fetch-profiles.mjs && node scripts/fetch-calendars.mjs",
    "data:build": "tsx scripts/build-data.ts && tsx scripts/build-calendars.ts && npm run data:validate",
    "data:validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
